{
  "expo": {
    "name": "ePurse",
    "slug": "epurse",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FF5A1F"
        }
      ],
      "./plugins/withEPurseAndroid",
      [
        "expo-navigation-bar",
        {
          "position": "relative",
          "theme": "light",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ePurse tags your transactions with where you made them, so you can see your spending on a map."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# react-native-reanimated — NOT covered by any shipped consumerProguardFiles; without this R8 strips the classes Reanimated's JNI layer resolves by name, and a release build crashes on first use of a worklet with minify on.\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.facebook.react.fabric.** { *; }"
          }
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "praveen-verma",
          "project": "react-native"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.epurse.app",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "ePurse uses notifications to detect financial messages and auto-categorise them.",
        "NSContactsUsageDescription": "ePurse uses your contacts so you can pick friends when splitting an expense.",
        "NSFaceIDUsageDescription": "ePurse uses Face ID to protect your account balances."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF5A1F"
      },
      "package": "com.epurse.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.DETECT_SCREEN_CAPTURE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "aa096ea5-1aae-4d07-aa45-f17b9f52ef42"
      }
    },
    "owner": "13pvn",
    "scheme": [
      "epurse",
      "com.googleusercontent.apps.32024277404-2b3d0i62i3er57out9qah6n15g3deggt"
    ]
  }
}
