# Secrets that must never be committed. SENTRY_AUTH_TOKEN lives here for LOCAL
# builds (build.sh sources it); cloud builds read it from an EAS secret instead.
.env
.env.*

# Native projects are GENERATED by `expo prebuild` (CNG).
# They are NOT committed: with android/ or ios/ in the repo, EAS Build refuses to
# sync orientation/icon/userInterfaceStyle/plugins/ios/android/scheme from
# app.json, so a permission added there would be silently dropped from a cloud
# build. Hand-written natives live in plugins/android/ and are copied back in by
# withEPurseAndroid on every prebuild. Run `npm run setup` to regenerate.
/android/
/ios/
