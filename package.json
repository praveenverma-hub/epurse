{
  "name": "epurse",
  "version": "1.5.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "test": "npm run test:parser && npm run test:self && npm run test:group && npm run test:store && npm run test:dateRange && npm run test:backup && npm run test:payload && npm run test:drive",
    "test:parser": "node --no-warnings --import ./src/utils/__tests__/_register.mjs src/utils/__tests__/messageParser.test.mjs",
    "test:self": "node --no-warnings --import ./src/utils/__tests__/_register.mjs src/utils/__tests__/selfTransfer.test.mjs",
    "test:group": "node --no-warnings --import ./src/utils/__tests__/_register.mjs src/utils/__tests__/groupExpense.test.mjs",
    "test:store": "node --no-warnings src/utils/__tests__/storeIntegration.test.mjs",
    "test:dateRange": "node --no-warnings --import ./src/utils/__tests__/_register.mjs src/utils/__tests__/dateRange.test.mjs",
    "test:backup": "node --no-warnings src/utils/__tests__/backupCrypto.test.mjs",
    "test:payload": "node --no-warnings src/utils/__tests__/backupPayload.test.mjs",
    "test:drive": "node --no-warnings src/utils/__tests__/backupDrive.test.mjs",
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "eas build -p android --profile preview",
    "build:local": "eas build --local --platform android --profile preview",
    "build:aab": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile preview",
    "prebuild": "expo prebuild",
    "build:apk-local": "expo prebuild --clean && cd android && ./gradlew assembleRelease",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-community/datetimepicker": "7.7.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@shopify/react-native-skia": "0.1.221",
    "@types/react": "~18.2.45",
    "expo": "~50.0.14",
    "expo-auth-session": "~5.4.0",
    "expo-av": "~13.10.6",
    "expo-clipboard": "~5.0.1",
    "expo-contacts": "~12.8.2",
    "expo-crypto": "~12.8.1",
    "expo-file-system": "~16.0.9",
    "expo-haptics": "~12.8.1",
    "expo-linear-gradient": "~12.7.2",
    "expo-local-authentication": "~13.8.0",
    "expo-location": "~16.5.5",
    "expo-media-library": "~15.9.1",
    "expo-navigation-bar": "~2.8.1",
    "expo-notifications": "~0.27.7",
    "expo-print": "~12.8.1",
    "expo-secure-store": "~12.8.1",
    "expo-sharing": "~11.10.0",
    "expo-status-bar": "~1.11.1",
    "expo-web-browser": "~12.8.2",
    "lottie-react-native": "6.5.1",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-android-sms-listener": "^0.8.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-get-sms-android": "^2.1.0",
    "react-native-pager-view": "6.2.3",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-tab-view": "^3.5.2",
    "react-native-view-shot": "~3.8.0",
    "typescript": "^5.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  },
  "private": true
}
